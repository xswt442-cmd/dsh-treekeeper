{
  "name": "dsh-treekeeper",
  "version": "0.0.1",
  "description": "DSH 运行时进程树对账与治理：把官方任务账本（jobs/子代理）与本机真实进程树对账，标出未归属/泄漏/孤儿进程并守卫式树杀。Runtime process-tree reconciliation for DeepSeek Harness: join the official jobs & subagent ledger with the live OS process tree, surface unattributed/leaked/orphaned children, and kill trees behind creation-time guards.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/attribute.test.js test/leak.test.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "treekeeper",
    "summary": "账本↔OS 对账引擎：跨会话任务/子代理账本对照本机真实进程树，标出未归属、泄漏与孤儿进程，守卫式（创建时间预检+白名单）树杀，插件级常驻子进程审计。",
    "categories": ["dev", "Web UI"],
    "surfaces": ["host", "web"],
    "capabilities": {},
    "compatibility": {
      "dsh": ">=0.1.0-rc.6",
      "node": ">=20"
    },
    "permissions": {
      "network": ["http://127.0.0.1:*"],
      "os": ["process-list", "process-terminate"]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xswt442-cmd/dsh-treekeeper.git"
  },
  "homepage": "https://github.com/xswt442-cmd/dsh-treekeeper#readme",
  "bugs": {
    "url": "https://github.com/xswt442-cmd/dsh-treekeeper/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "dsh-plugin",
    "process-manager",
    "process-tree",
    "leak-detection"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
