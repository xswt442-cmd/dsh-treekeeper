{
  "name": "dsh-treekeeper",
  "version": "0.3.0",
  "description": "DSH 运行时进程树对账与治理：把当前宿主的任务账本与本机真实进程树对账，标出未归属/泄漏/孤儿进程并守卫式树杀。Runtime process-tree reconciliation for DeepSeek Harness: join the current host's job ledger with the live OS process tree, surface unattributed/leaked/orphaned children, and kill trees behind creation-time guards.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "npm run dock:check && npm run guard:check && npm run loopback:check && node --test test/*.test.js",
    "dock:sync": "dsh-mini-utility-dock sync lib/client.js",
    "dock:check": "dsh-mini-utility-dock check lib/client.js",
    "loopback:sync": "dsh-mini-utility-dock sync lib/shared.js",
    "guard:sync": "dsh-mini-utility-dock sync lib/shared.js",
    "loopback:check": "dsh-mini-utility-dock check lib/shared.js",
    "guard:check": "dsh-mini-utility-dock check lib/shared.js",
    "docs:check": "dsh-plugin-docs"
  },
  "devDependencies": {
    "dsh-mini-utility-dock": "0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xswt442-cmd/dsh-treekeeper.git"
  },
  "homepage": "https://github.com/xswt442-cmd/dsh-treekeeper#readme",
  "bugs": {
    "url": "https://github.com/xswt442-cmd/dsh-treekeeper/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "dsh-plugin",
    "process-manager",
    "process-tree",
    "leak-detection"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
